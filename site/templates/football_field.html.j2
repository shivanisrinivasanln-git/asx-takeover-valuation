{% from "macros.html.j2" import source_mark %}
<section class="football-field" aria-labelledby="football-field-heading">
  <h2 id="football-field-heading">Value per share by method</h2>
  {% include "football_field_chart.html.j2" %}
  <p class="note">Shaded bars are my estimate by each method, the solid bar is my combined range and the outlined bar is the independent expert's range. A tick marks my preferred value. The expert published a range and no preferred value. The solid line is the offer and the dashed line is the undisturbed price.</p>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Value per share by method table">
  <table class="figures">
    <caption>Value per share by method, A$</caption>
    <thead>
      <tr><th scope="col">Method</th><th scope="col" class="num">Low</th><th scope="col" class="num">Preferred</th><th scope="col" class="num">High</th></tr>
    </thead>
    <tbody>
      {% for row in field.rows %}
      <tr>
        <th scope="row">{{ row.table_label }}</th>
        <td class="num" data-key="{{ row.low_key }}">{{ source_mark(row.low_ref, row.low_text) if row.low_ref else row.low_text }}</td>
        <td class="num"{% if row.preferred_key %} data-key="{{ row.preferred_key }}"{% endif %}>{{ row.preferred_text if row.preferred_text else "Not published" }}</td>
        <td class="num" data-key="{{ row.high_key }}">{{ source_mark(row.high_ref, row.high_text) if row.high_ref else row.high_text }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Reference prices">
  <table class="figures reference-prices">
    <caption>Reference prices, A$</caption>
    <thead>
      <tr><th scope="col">Price</th><th scope="col" class="num">Value</th></tr>
    </thead>
    <tbody>
      {% for price in field.reference_prices %}
      <tr>
        <th scope="row">{{ price.label }}</th>
        <td class="num" data-key="{{ price.key }}">{{ source_mark(price.ref, price.text) }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</section>
