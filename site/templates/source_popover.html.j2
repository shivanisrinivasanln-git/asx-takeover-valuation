<div id="source-popover" class="source-popover" role="dialog" aria-labelledby="source-popover-name" tabindex="-1" hidden>
  <p id="source-popover-name" class="source-popover-name"></p>
  <dl>
    <div><dt>Document</dt><dd data-field="document"></dd></div>
    <div><dt>Page or table</dt><dd data-field="page"></dd></div>
    <div><dt>As at</dt><dd data-field="date"></dd></div>
  </dl>
  <div class="source-popover-actions">
    <a class="source-popover-link" hidden></a>
    <button type="button" class="source-popover-close">Close</button>
  </div>
</div>
