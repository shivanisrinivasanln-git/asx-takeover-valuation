<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ content_security_policy }}">
<meta name="referrer" content="{{ referrer_policy }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ meta.target }}{% endblock %}</title>
<link rel="stylesheet" href="static/tokens.css">
<link rel="stylesheet" href="static/site.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to the content</a>
<header class="site-header">
  <div class="page">
    <p class="site-name">{{ meta.target }}</p>
    <nav aria-label="Pages">
      {% for file, label in pages %}
      <a href="{{ file }}"{% if current == file %} aria-current="page"{% endif %}>{{ label }}</a>
      {% endfor %}
    </nav>
  </div>
</header>
<main id="main" class="page">
<h1>{% block heading %}{{ meta.target }}{% endblock %}</h1>
<dl class="docket" aria-label="The deal">
  {% for label, text in frame.docket %}
  <div><dt>{{ label }}</dt><dd>{{ text }}</dd></div>
  {% endfor %}
</dl>
{% block main %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="page">
    <dl class="colophon" aria-label="About this build">
      {% for label, text in frame.colophon %}
      <div><dt>{{ label }}</dt><dd>{{ text }}</dd></div>
      {% endfor %}
      <div><dt>Commit</dt><dd><a href="{{ frame.commit_url }}">{{ frame.commit_short }}</a></dd></div>
    </dl>
    <p>{{ frame.unit_note }}</p>
    <p>{{ disclaimer }}</p>
  </div>
</footer>
</body>
</html>
