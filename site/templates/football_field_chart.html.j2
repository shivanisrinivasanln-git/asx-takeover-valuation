  <svg class="chart" width="100%" height="{{ field.height }}" role="img" aria-labelledby="ff-title ff-desc">
    <title id="ff-title">{{ field.title }}</title>
    <desc id="ff-desc">{{ field.description }}</desc>
    {% for tick in field.ticks %}
    <line class="grid{% if not tick.major %} minor{% endif %}" x1="{{ tick.x }}" x2="{{ tick.x }}" y1="{{ field.plot_top }}" y2="{{ field.plot_bottom }}"/>
    <text class="axis-label{% if not tick.major %} minor{% endif %}" x="{{ tick.x }}" y="{{ field.top_axis_y }}" text-anchor="{{ tick.anchor }}">{{ tick.label }}</text>
    <text class="axis-label{% if not tick.major %} minor{% endif %}" x="{{ tick.x }}" y="{{ field.bottom_axis_y }}" text-anchor="{{ tick.anchor }}">{{ tick.label }}</text>
    {% endfor %}
    <line class="rule-offer" x1="{{ field.offer.x }}" x2="{{ field.offer.x }}" y1="{{ field.top_axis_y + 6 }}" y2="{{ field.plot_bottom }}"/>
    <line class="rule-undisturbed" x1="{{ field.undisturbed.x }}" x2="{{ field.undisturbed.x }}" y1="{{ field.top_axis_y + 6 }}" y2="{{ field.plot_bottom }}"/>
    {% for row in field.rows %}
    <g class="row" data-row="{{ row.id }}">
      <text class="row-label" x="0" y="{{ row.label_y }}">{{ row.label }}</text>
      <rect class="bar {{ 'bar-expert' if not row.owner else 'bar-combined' if row.id == 'combined' else 'bar-mine' }}" x="{{ row.x_low }}" y="{{ row.bar_y }}" width="{{ row.width }}" height="{{ row.bar_height }}"/>
      {% if row.x_preferred %}
      {% if row.id == 'combined' %}
      <line class="preferred-halo" x1="{{ row.x_preferred }}" x2="{{ row.x_preferred }}" y1="{{ row.tick_y1 }}" y2="{{ row.tick_y2 }}"/>
      {% endif %}
      <line class="preferred-tick" x1="{{ row.x_preferred }}" x2="{{ row.x_preferred }}" y1="{{ row.tick_y1 }}" y2="{{ row.tick_y2 }}"/>
      {% endif %}
      <text class="end-label" x="{{ row.low_label_x }}" dx="-6" y="{{ row.mid_y }}" dy="0.35em" text-anchor="end" data-key="{{ row.low_key }}">{{ row.low_text }}</text>
      <text class="end-label" x="{{ row.high_label_x }}" dx="6" y="{{ row.mid_y }}" dy="0.35em" text-anchor="start" data-key="{{ row.high_key }}">{{ row.high_text }}</text>
    </g>
    {% endfor %}
    <text class="rule-label" x="{{ field.offer.x }}" y="{{ field.top_label_y }}" text-anchor="{{ field.offer.anchor }}" data-key="{{ field.offer.key }}">{{ field.offer.text }}</text>
    <text class="rule-label" x="{{ field.undisturbed.x }}" y="{{ field.bottom_label_y }}" text-anchor="{{ field.undisturbed.anchor }}" data-key="{{ field.undisturbed.key }}">{{ field.undisturbed.text }}</text>
  </svg>
